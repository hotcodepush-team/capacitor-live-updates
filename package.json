{
  "name": "@hotcodepush/capacitor-live-updates",
  "version": "0.1.0",
  "description": "Capacitor live updates by HotCodePush: the plugin that delivers over-the-air (OTA) updates to your Capacitor app",
  "type": "module",
  "license": "MIT",
  "author": "Genz IT Solutions GmbH",
  "homepage": "https://hotcodepush.com/docs/sdks/capacitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotcodepush-team/capacitor-live-updates.git"
  },
  "bugs": {
    "url": "https://github.com/hotcodepush-team/capacitor-live-updates/issues"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "live updates",
    "ota updates",
    "over-the-air updates",
    "code push",
    "hot code push",
    "code-push",
    "codepush",
    "hot-code-push",
    "live-update",
    "live-updates",
    "ota",
    "ota-update",
    "ota-updates",
    "over-the-air",
    "over-the-air-updates",
    "capacitor-live-update"
  ],
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/hotcodepush.gradle",
    "android/libs/m2/",
    "dist/",
    "ios/Frameworks/HotCodePushCore.xcframework/",
    "ios/Sources/",
    "scripts/",
    "!scripts/*.test.ts",
    "!scripts/download-core-android.mjs",
    "!scripts/download-core-ios.mjs",
    "!scripts/write-sdk-version.mjs",
    "HotcodepushCapacitorLiveUpdates.podspec",
    "Package.swift"
  ],
  "scripts": {
    "build": "npm run clean && node scripts/write-sdk-version.mjs && node scripts/download-core-android.mjs && node scripts/download-core-ios.mjs && tsc --project tsconfig.build.json && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "fmt": "eslint . --fix && prettier --write . && swiftlint --fix --quiet ios",
    "lint": "eslint . && prettier --check . && swiftlint lint --quiet --strict ios",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:android": "node scripts/write-sdk-version.mjs && node scripts/download-core-android.mjs && cd android && ./gradlew build --console=plain",
    "verify:ios": "node scripts/write-sdk-version.mjs && xcodebuild -scheme HotcodepushCapacitorLiveUpdates -destination generic/platform=iOS -quiet build"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "pkg-pr-new": "0.0.88",
    "prettier": "3.9.8",
    "rimraf": "6.1.2",
    "rollup": "4.65.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "hotcodepush": {
    "coreAndroid": {
      "version": "0.2.1",
      "checksum": "c9a28538d858ddef03c6055d3d8647b49de5b67d10dc15bfd493f45437c551a4"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hotcodepush/protocol": "https://pkg.pr.new/hotcodepush-team/protocol/@hotcodepush/protocol@af6e874f7031ac5f727213aad3f396622afe9a10"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
